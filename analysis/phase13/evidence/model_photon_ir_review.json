    "smooth_cone_profile": {
      "source": "Template/LO/SubProcesses/cuts.f",
      "first_line": 1341,
      "last_line": 1353,
      "lines": [
        {
          "line": 1341,
          "text": "      function chi_gamma_iso(dr,R0,xn,epsgamma,pTgamma)"
        },
        {
          "line": 1342,
          "text": "c Eq.(3.4) of Phys.Lett. B429 (1998) 369-374 [hep-ph/9801442]"
        },
        {
          "line": 1343,
          "text": "      implicit none"
        },
        {
          "line": 1344,
          "text": "      real*8 chi_gamma_iso,dr,R0,xn,epsgamma,pTgamma"
        },
        {
          "line": 1345,
          "text": "      real*8 tmp,axn"
        },
        {
          "line": 1346,
          "text": "c"
        },
        {
          "line": 1347,
          "text": "      axn=abs(xn)"
        },
        {
          "line": 1348,
          "text": "      tmp=epsgamma*pTgamma"
        },
        {
          "line": 1349,
          "text": "      if(axn.ne.0.d0)then"
        },
        {
          "line": 1350,
          "text": "        tmp=tmp*( (1-cos(dr))/(1-cos(R0)) )**axn"
        },
        {
          "line": 1351,
          "text": "      endif"
        },
        {
          "line": 1352,
          "text": "      chi_gamma_iso=tmp"
        },
        {
          "line": 1353,
          "text": "      return"
        }
      ]
    },
