# Normalize text in Git and use LF on every platform, including PowerShell.
* text=auto eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.cc text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Explicit binary handling for future small, reviewed assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.root binary
*.zip binary
