# Normalize text in Git and use LF on every platform, including PowerShell.
* text=auto eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.cc text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Explicit binary handling for future small, reviewed assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.root binary
*.zip binary
*.lhe.gz binary
*.hepmc3.gz binary

# Preserve actual generated defaults, including upstream empty-value spacing.
simulation/pythia8/evidence/*/effective_settings.cmnd -whitespace
simulation/pythia8/evidence/*/effective_particle_data.xml -whitespace
simulation/pythia8/licenses/*_COPYING -whitespace

# Preserve the exact upstream license bytes accompanying the pinned cards.
simulation/delphes/cards/UPSTREAM_LICENSE_GPL3.txt -whitespace
simulation/delphes/cards/upstream_delphes_card_ATLAS_3.5.1.tcl -whitespace
simulation/delphes/cards/atlas_like_bbgg_baseline.tcl -whitespace
reference_samples/delphes/pp_bbgg_atlas_like/detector_card.tcl -whitespace
reference_samples/delphes/pp_ccgg_atlas_like/detector_card.tcl -whitespace
reference_samples/delphes/pp_jjgg_light_atlas_like/detector_card.tcl -whitespace
