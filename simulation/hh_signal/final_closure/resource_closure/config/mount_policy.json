  "sources": {
    "MOUNTINFO": "https://man7.org/linux/man-pages/man5/proc_pid_mountinfo.5.html",
    "PROPAGATION": "https://docs.kernel.org/filesystems/sharedsubtree.html",
    "NAMESPACES": "https://man7.org/linux/man-pages/man7/namespaces.7.html",
    "TMPFS": "https://docs.kernel.org/filesystems/tmpfs.html",
    "PROJECT": "USER_AUTHORIZATION_PHASE7I_AUTONOMOUS_ENGINEERING_FIXED_LIMITS"
  },
  "rules": {
    "P00": {
      "rule": "Exact reviewed policy byte and semantic identity; no import-time filesystem reads.",
      "sources": [
        "PROJECT"
      ]
    },
    "P01": {
      "rule": "Bounded complete mount capture, final LF, documented escaped fields, no ambiguous IDs or mountpoints.",
      "sources": [
        "MOUNTINFO",
        "PROJECT"
      ]
    },
    "P02": {
      "rule": "One visible root; only its parent may be outside the namespace. Reject cycles, hidden overlays and invalid ancestry.",
      "sources": [
        "MOUNTINFO",
        "PROJECT"
      ]
    },
    "P03": {
      "rule": "Only exact dedicated private tmpfs may be rw; exact block/inode readback is bound to snapshot, mount ID and namespace.",
      "sources": [
        "TMPFS",
        "PROJECT"
      ]
    },
    "P04": {
      "rule": "Source must be covered by ro mount, including a readonly ancestor. Unreviewed source and private subtree overmounts are rejected.",
      "sources": [
        "MOUNTINFO",
        "PROJECT"
      ]
    },
    "P05": {
      "rule": "Reject shared/slave/unknown propagation; incoming or outgoing mounts are not proven contained. Private or unbindable only.",
      "sources": [
        "PROPAGATION",
        "PROJECT"
      ]
    },
    "P06": {
      "rule": "Source, runtime/WSL, persistent and unknown non-private mounts must be ro. A rw backing superblock does not make a ro bind writable.",
      "sources": [
        "MOUNTINFO",
        "PROJECT"
      ]
    },
    "P07": {
      "rule": "Kernel API path grants no access. Exact ro mount identity, namespace proof and source-pinned fixed-target syscall-denial data are prerequisites; host-state access remains unverified.",
      "sources": [
        "MOUNTINFO",
        "NAMESPACES",
        "PROJECT"
      ]
    },
    "P08": {
      "rule": "The source-pinned producer tests six invalid syscall targets only. Exact EPERM data and PID/snapshot/source bindings are checked; no proc write or real-device test or live-kernel authenticity is claimed.",
      "sources": [
        "PROJECT"
      ]
    },
    "P09": {
      "rule": "Bounded safe projection; private paths remain hashed. Any evidence overflow fails closed explicitly.",
      "sources": [
        "PROJECT"
      ]
    },
    "P10": {
      "rule": "Passing pure source predicates never grants runtime, capacity, FULL envelope or formal build approval.",
      "sources": [
        "PROJECT"
      ]
    }
  }
}
